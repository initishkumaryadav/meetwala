# ── OpenAI ──────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxx

# ── Google OAuth 2.0 ────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ── Twilio (WhatsApp) ───────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Deepgram (Speech-to-Text) ───────────────────────
DEEPGRAM_API_KEY=xxxx

# ── ElevenLabs (Text-to-Speech) ─────────────────────
ELEVENLABS_API_KEY=sk_xxxx
ELEVENLABS_VOICE_ID=xxxx

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=generate-a-random-64-char-string
JWT_EXPIRES_IN=7d

# ── App URL ─────────────────────────────────────────
# In production, set to your actual domain (e.g. https://meetwala.yourdomain.com)
APP_URL=http://localhost:5173

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=meetwala
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=meetwala_db
# For local docker: postgresql://meetwala:change-this-strong-password@postgres:5432/meetwala_db
# For Neon cloud:   postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://meetwala:change-this-strong-password@postgres:5432/meetwala_db

# ── Redis ───────────────────────────────────────────
# For local docker: leave empty. For Upstash: set your rediss:// URL
REDIS_PASSWORD=change-this-strong-password
REDIS_URL=redis://default:change-this-strong-password@redis:6379

# ── ChromaDB ────────────────────────────────────────
CHROMA_AUTH_TOKEN=change-this-strong-password

# ── LangSmith (optional, for LLM tracing) ──────────
LANGCHAIN_API_KEY=lsv2_pt_xxxx
LANGCHAIN_PROJECT=meetwala

# ── Service URLs (docker-compose handles these) ─────
AI_SERVICE_URL=http://ai-service:8000
CHROMA_HOST=chromadb
